# ==========================================
# Configurações do Servidor
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# Configurações do Banco de Dados (MySQL)
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sharearide_db
DB_USER=root
DB_PASSWORD=sua_senha_do_banco
DB_DIALECT=mysql

# ==========================================
# Segurança
# ==========================================
# Chave secreta para assinar os tokens (Obrigatório para o servidor ligar)
JWT_SECRET=sua_chave_secreta_super_segura_aqui_12345

# ==========================================
# Seeder Administrativo
# ==========================================
# Credenciais criadas automaticamente ao rodar o seeder inicial
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=senha_padrao_admin_123